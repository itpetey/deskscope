#!/bin/bash
# Wrapper that ensures display environment is set before launching deskscope.
# Used by deskscope.service so the GUI can find the active graphical session.

# If not already set, probe for an active Wayland or X11 display
if [ -z "$WAYLAND_DISPLAY" ] && [ -z "$DISPLAY" ]; then
    if [ -n "$XDG_RUNTIME_DIR" ]; then
        # Look for a Wayland socket
        for socket in "$XDG_RUNTIME_DIR"/wayland-*; do
            if [ -S "$socket" ]; then
                WAYLAND_DISPLAY="$(basename "$socket")"
                export WAYLAND_DISPLAY
                echo "Auto-detected WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
                break
            fi
        done
    fi

    # Fall back to X11 defaults if Wayland not found
    if [ -z "$WAYLAND_DISPLAY" ]; then
        export DISPLAY="${DISPLAY:-:0}"
        export XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}"
        echo "Falling back to X11: DISPLAY=$DISPLAY"
    fi
fi

exec /usr/local/bin/deskscope "$@"
