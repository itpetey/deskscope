component MenuButton inherits Rectangle {
    in property <string> text;
    in property <string> sub-text;
    in property <brush> bg;
    in property <length> button-size;
    callback clicked();

    width: button-size;
    height: button-size;
    background: bg;
    border-radius: button-size * 12%;
    border-width: 4px;
    border-color: white;

    Text {
        text: root.text;
        color: white;
        font-size: root.button-size * 16%;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }

    if root.sub-text != "": Text {
        text: root.sub-text;
        color: #33CCFF;
        font-size: root.button-size * 14%;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

export component DeskscopeWindow inherits Window {
    in property <image> camera-image;
    in property <bool> menu-visible: false;
    in property <bool> powered-off: false;
    in property <string> status-text: "";

    callback show-menu();
    callback dismiss-menu();
    callback wake();
    callback power-off();
    callback take-photo();

    title: "Deskscope";
    background: black;
    full-screen: true;

    // Camera feed fills the window.
    Image {
        width: root.width;
        height: root.height;
        source: camera-image;
        image-fit: cover;
        image-rendering: smooth;

        TouchArea {
            clicked => {
                if root.powered-off {
                    root.wake();
                } else if !root.menu-visible {
                    root.show-menu();
                } else {
                    root.dismiss-menu();
                }
            }
        }
    }

    // Menu overlay with settings and actions.
    if root.menu-visible && !root.powered-off: Rectangle {
        width: root.width;
        height: root.height;
        background: #CC000000;

        // Tap outside the button grid dismisses the menu.
        TouchArea {
            clicked => {
                root.dismiss-menu();
            }
        }

        property <length> cell-size: min(root.width / 2, root.height);

        GridLayout {
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;

            MenuButton {
                text: "Power off";
                bg: #CC3333;
                button-size: cell-size;
                row: 0;
                col: 0;
                clicked => {
                    root.power-off();
                }
            }

            MenuButton {
                text: "Take photo";
                bg: #33CC33;
                button-size: cell-size;
                row: 0;
                col: 1;
                clicked => {
                    root.take-photo();
                }
            }
        }
    }

    // Transient status message overlay.
    if root.status-text != "": Text {
        x: (root.width - self.width) / 2;
        y: root.height * 10%;
        text: root.status-text;
        color: #33CCFF;
        font-size: root.width / 20;
        font-weight: 700;
    }

    // Power-off overlay absorbs all input until a tap wakes the device.
    if root.powered-off: Rectangle {
        width: root.width;
        height: root.height;
        background: black;
        TouchArea {
            clicked => {
                root.wake();
            }
        }
    }
}
